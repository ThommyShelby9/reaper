<?xml version="1.0" encoding="utf-8"?>
<!-- Touche du widget : une tranche plus sombre dessous, la face s'y enfonce quand on appuie. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape><solid android:color="#FF0A0A0A" /><corners android:radius="12dp" /></shape></item>
            <item android:top="3dp"><shape><solid android:color="#FF1C1C1E" /><stroke android:width="1dp" android:color="#FF3A3A3C" /><corners android:radius="12dp" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#FF0A0A0A" /><corners android:radius="12dp" /></shape></item>
            <item android:bottom="3dp"><shape><solid android:color="#FF1C1C1E" /><stroke android:width="1dp" android:color="#FF3A3A3C" /><corners android:radius="12dp" /></shape></item>
        </layer-list>
    </item>
</selector>
